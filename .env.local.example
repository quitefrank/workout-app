# Copy to .env.local and fill in real values. Never commit .env.local.

# ============================================================
# Supabase
# Find these in your Supabase project: Project Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS. Never expose to the browser.
# Only used by scripts/seed-from-notion.ts and other admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Notion (read-only, only needed for the one-time seed)
# Create an internal integration at https://www.notion.so/profile/integrations
# Share the Workout Database parent page with the integration.
# ============================================================
NOTION_API_KEY=secret_xxx

# Notion database IDs from the Workout Database parent page.
NOTION_MUSCLE_GROUPS_DB=766b3dad-3ead-4c3c-89dc-87607260c8df
NOTION_EXERCISES_DB=eba25da8-6d8b-4367-b2f1-a9048cb0b1c7
NOTION_WORKOUTS_DB=caf5ffe0-0a2f-440f-bef5-6939ed6893fb
NOTION_SESSIONS_DB=6280dbb2-b2ec-42d0-aac9-64cda92580f3

# ============================================================
# Seed config
# Frank's Supabase auth.users id. Create an account first via
# the Supabase dashboard, then paste the user id here.
# ============================================================
# Email for the auth user the seeds write for. `bun run user:create`
# creates it (or finds it) and prints the id to paste below.
SEED_USER_EMAIL=

SEED_USER_ID=
